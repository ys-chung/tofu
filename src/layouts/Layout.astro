---
import Nav from "../components/Nav.astro"
import Footer from "../components/Footer.astro"
import Analytics from "../private/Analytics.astro"
import FontPreloads from "../components/FontPreloads.astro"

export interface Props {
  title: string
  description: string
  image: string
  imageAlt: string
  metaDescription?: string
}

const {
  title: pageTitle,
  description,
  image: imagePath,
  imageAlt,
  metaDescription = Astro.props.description
} = Astro.props
const title = `❒ Tofu | ${pageTitle}`
const image = new URL(imagePath, Astro.url)

import "../styles/global.css"
import "../private/mori/mori.css"
---

<!doctype html>
<html lang="en">
  <head>
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.png" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta charset="UTF-8" />
    <link rel="canonical" href={Astro.site} />
    <meta name="description" content={metaDescription} />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content="Tofu" />
    <meta property="og:image" content={image} />
    <meta property="og:image:url" content={image} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:creator" content="@_yschung" />
    <meta name="title" content={title} />

    <FontPreloads />
  </head>
  <body
    class="bg-stone-50 selection:bg-stone-300 selection:bg-opacity-60 font-sans"
  >
    <div class="mx-auto max-w-3xl px-4 pb-4 text-neutral-900">
      <Nav />
      <main>
        <slot />
      </main>
      <Footer />
    </div>

    {import.meta.env.PROD && <Analytics />}
  </body>
</html>
